{
  "name": "simple-expenses-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@simple-expenses/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "dev:mobile": "turbo run dev --filter=@simple-expenses/mobile"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5",
    "prettier": "^3.7.4"
  }
}
