// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better Auth Models
model user {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Role-based access control (Better Auth admin plugin)
  role       String   @default("user")
  banned     Boolean  @default(false)
  banReason  String?
  banExpires DateTime?

  // Stripe subscription fields
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?   // trialing, active, past_due, canceled, incomplete
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  lastTrialReminderAt  DateTime?

  // Plan tier: free | pro | premium (updated by Stripe webhook on subscription events)
  planTier             String    @default("free")

  preferredCurrency    String    @default("AED")
  onboardingCompleted  Boolean   @default(false)

  accounts account[]
  sessions session[]
  verifications verification[]
  creditCards credit_card[]
  bankAccounts bank_account[]
  categories category[]
  spendingLimits spending_limit[]
  savingsGoals   savings_goal[]
  auditLogs audit_log[]
}

model session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  accessToken  String?
  refreshToken String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  expiresAt             DateTime?
  scope                 String?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId, accountId])
  @@index([userId])
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String?
  user   user?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, value])
  @@index([userId])
}

// App Models
model credit_card {
  id                  String   @id @default(cuid())
  name                String
  billGenerationDate  Int      // Day of month (1-31)
  paymentDate         Int      // Day of month (1-31)
  cardLimit           Float
  availableBalance    Float    @default(0) // Tracks remaining available balance
  currency            String   @default("AED")
  userId              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions transaction[]
  invoices     invoice[]

  @@index([userId])
}

model bank_account {
  id              String   @id @default(cuid())
  name            String
  initialBalance  Float
  currentBalance  Float
  currency        String   @default("AED")
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions transaction[]
  invoicePayments invoice[]

  @@index([userId])
}

model invoice {
  id                       String    @id @default(cuid())
  creditCardId             String
  billStartDate            DateTime
  billEndDate              DateTime
  paymentDueDate           DateTime
  totalAmount              Float
  paidAmount               Float     @default(0) // Track how much has been paid
  creditFromPreviousMonth  Float     @default(0) // Credit balance carried forward from previous invoice overpayment
  isPaid                   Boolean   @default(false)
  paidAt                   DateTime?
  paidFromBankAccountId    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  creditCard          credit_card   @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  paidFromBankAccount bank_account? @relation(fields: [paidFromBankAccountId], references: [id], onDelete: SetNull)

  @@unique([creditCardId, billStartDate, billEndDate])
  // Composite indexes: filter by card+status and card+date range (common dashboard queries)
  @@index([creditCardId, isPaid])
  @@index([creditCardId, billStartDate])
  // Kept individual indexes for backward compat / single-column lookups
  @@index([creditCardId])
  @@index([isPaid])
}

model transaction {
  id                  String   @id @default(cuid())
  name                String
  amount              Float
  date                DateTime
  category            String
  type                String   @default("expense") // expense, income, transfer
  notes               String?  // Optional personal notes/description
  installments        Int      @default(1) // Number of installments (1 for one-time payment)
  parentTransactionId String?  // Reference to the parent transaction if this is part of an installment
  installmentNumber   Int?     // Which installment number this is (1, 2, 3, etc.)
  creditCardId        String?
  bankAccountId       String?

  // Recurring transaction fields
  isRecurring         Boolean   @default(false)         // Is this a recurring transaction template?
  recurringFrequency  String?                           // "daily", "weekly", "monthly", "yearly"
  recurringEndDate    DateTime?                         // Optional end date for the recurrence
  isRecurringActive   Boolean   @default(true)          // Can be paused/canceled
  nextRecurDate       DateTime?                         // Next scheduled recurrence date (for cron job)
  parentRecurringId   String?                           // Links cron-generated instances to their template

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  creditCard         credit_card?  @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  bankAccount        bank_account? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  parentTransaction  transaction?  @relation("InstallmentRelation", fields: [parentTransactionId], references: [id], onDelete: Cascade)
  childTransactions  transaction[] @relation("InstallmentRelation")
  parentRecurring    transaction?  @relation("RecurringInstances", fields: [parentRecurringId], references: [id], onDelete: SetNull)
  recurringInstances transaction[] @relation("RecurringInstances")

  // Composite indexes for common query patterns: filter by account + sort by date
  @@index([creditCardId, createdAt])
  @@index([bankAccountId, createdAt])
  // Kept individual indexes for FK lookups / installment traversal
  @@index([creditCardId])
  @@index([bankAccountId])
  @@index([date])
  @@index([parentTransactionId])
  @@index([category])
  @@index([isRecurring, isRecurringActive, nextRecurDate])
  @@index([parentRecurringId])
}

model category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  icon      String   @default("tag")
  type      String   @default("expense") // expense, income, both
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model spending_limit {
  id           String   @id @default(cuid())
  categoryName String
  amount       Float
  month        Int
  year         Int
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryName, month, year])
  // Composite index: look up limits for a specific user+month+year (most common pattern)
  @@index([userId, month, year])
  @@index([userId])
}

model savings_goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  color         String    @default("#1a9e5c")
  deadline      DateTime?
  isCompleted   Boolean   @default(false)
  userId        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model audit_log {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite index: list a user's audit history sorted by time (most common admin query)
  @@index([userId, createdAt])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model rateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int    @default(0)
  lastRequest BigInt
}

model feature_flag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
